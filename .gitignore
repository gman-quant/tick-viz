# .gitignore

# -----------------------------
# 1. 專案輸出與報告
# -----------------------------
# (HTML 報告)
*.html
# (資料快取)
/data/
# (測試相關)
/tests/
# (報告輸出目錄)
/Dashboard_snapshot/

# -----------------------------
# 2. 虛擬環境
# -----------------------------
/venv/
/env/
/.venv/
/.env/
__pypackages__/

# -----------------------------
# 3. Python 暫存檔與快取
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# -----------------------------
# 4. Python 打包與建置檔
# -----------------------------
*.so
*.egg
*.egg-info/
dist/
build/
*.spec

# -----------------------------
# 5. Notebooks 暫存檔
# -----------------------------
.ipynb_checkpoints/
*.ipynb

# -----------------------------
# 6. IDE / 編輯器設定檔
# -----------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------
# 7. 作業系統檔案
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# 8. 日誌與資料庫檔案
# -----------------------------
*.log
*.db
*.sqlite3

# -----------------------------
# 9. 敏感憑證 (金鑰)
# -----------------------------
# (環境變數檔案，包含敏感金鑰)
.env

# -----------------------------
# 10. 測試報告與覆蓋率
# -----------------------------
.pytest_cache/
.coverage
htmlcov/