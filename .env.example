# tick-viz/.env.example

# -----------------------------
# Shioaji API 憑證
# -----------------------------
SHIOAJI_API_KEY=your_shioaji_api_key
SHIOAJI_SECRET_KEY=your_shioaji_secret_key
# -----------------------------
# Kafka 伺服器設定
# -----------------------------
KAFKA_BOOTSTRAP_SERVERS=your_kafka_address:9092
KAFKA_TOPIC=your_topic_name